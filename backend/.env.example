# Runtime
APP_ENV=development
DEMO_MODE=true
AUTO_CREATE_DB=true
DATABASE_URL=sqlite:///./freightpilot.db
FRONTEND_ORIGIN=http://localhost:5173

# Authentication. Keep false for the existing local demo frontend.
# Set true before exposing the API to registered users.
AUTH_REQUIRED=false
JWT_SECRET_KEY=replace_with_a_long_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# PayPal Developer Sandbox. Client secret must never be placed in frontend/.env.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=replace_with_sandbox_client_id
PAYPAL_CLIENT_SECRET=replace_with_sandbox_client_secret
PAYPAL_WEBHOOK_ID=replace_when_webhook_is_configured
PAYPAL_TIMEOUT_SECONDS=15

# AI provider
AI_PROVIDER=gemini
AI_API_KEY=replace_with_your_ai_provider_key
AI_MODEL=gemini-2.0-flash
