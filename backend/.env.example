# LOCAL DEVELOPMENT ONLY. Never commit a populated .env file.
APP_ENV=development
DEMO_MODE=true
AUTO_CREATE_DB=true
AUTH_REQUIRED=false
DATABASE_URL=sqlite:///./freightpilot.db
FRONTEND_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:8000

# OAuth ID-token audience values (same IDs configured in the browser)
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Store the Apple .p8 private key with escaped newlines (\n); server-only.
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=
JWT_SECRET_KEY=development-only-change-this-before-deploying
ACCESS_TOKEN_EXPIRE_MINUTES=20
RATE_LIMIT_ENABLED=true
REDIS_URL=

# PayPal sandbox (backend only)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Gemini API (backend only; optional for local rules-based fallback)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.5-flash

# Verification delivery: console is development-only; production requires Resend + Twilio or Firebase.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=FreightPilot <no-reply@localhost>
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# TWILIO_AUTH_TOKEN is intentionally omitted; production uses a scoped API key.
TWILIO_FROM_NUMBER=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Private documents: local for dev, s3 for Render.
STORAGE_BACKEND=local
DOCUMENT_STORAGE_PATH=./var/documents
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAX_UPLOAD_BYTES=10485760
CLAMAV_HOST=localhost
CLAMAV_PORT=3310