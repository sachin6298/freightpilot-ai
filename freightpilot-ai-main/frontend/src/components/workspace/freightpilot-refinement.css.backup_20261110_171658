.auth-backdrop .auth-toggle-pill { border-color: #dce5e6 !important; background: #eef3f3 !important; }
.auth-backdrop .auth-toggle-pill button { color: #64757a !important; }
.auth-backdrop .auth-toggle-pill button.active { color: #fff !important; background: var(--page-teal) !important; }
.auth-backdrop .auth-right-head h3 { color: #20343a !important; font-size: clamp(26px,2.5vw,34px) !important; letter-spacing: -.9px !important; }
.auth-backdrop .auth-right-head p { color: #708086 !important; }
.auth-backdrop .auth-close-btn { color: #52656b !important; background: #eef3f3 !important; }
.auth-backdrop .auth-input-field, .auth-backdrop .auth-fields label input {
  min-height: 48px !important; border: 1px solid #d8e1e2 !important;
