.auth-backdrop .auth-forgot-link { color: var(--page-teal) !important; }
.auth-backdrop .auth-security-note, .auth-backdrop .auth-provider-note { color: #7a898e !important; }

/* Keep the entire product light, even when a previous browser session saved dark mode. */
