.chart-empty-state { min-height: 150px; display: grid; place-items: center; padding: 18px; color: var(--text-muted, #8a9198); border: 1px dashed rgba(128,138,150,.3); border-radius: 10px; font-size: 12px; text-align: center; }
@media (max-width: 780px) { .landing-film-section { padding-inline: 20px; } }
