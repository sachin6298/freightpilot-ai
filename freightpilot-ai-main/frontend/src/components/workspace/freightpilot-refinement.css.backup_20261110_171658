/* Landing and auth refinements */
.landing-nav-actions { display: flex; align-items: center; gap: 13px; }
.landing-nav-actions .fpw-theme-toggle { width: 34px; min-height: 34px; justify-content: center; padding: 0; border: 1px solid rgba(244,237,224,.18); border-radius: 50%; color: #f4ede0; background: rgba(255,255,255,.035); }
.landing-nav-actions .fpw-theme-toggle:hover { color: #fff; border-color: rgba(11, 115, 122,.65); background: rgba(11, 115, 122,.12); }
.landing-capability-strip { padding-top: 24px !important; padding-bottom: 24px !important; }
.landing-capability-strip .stats-metric-card strong { font-size: 24px; color: #0B737A; }
.landing-capability-strip .stats-metric-card span { text-transform: uppercase; letter-spacing: .65px; }
.landing-film-section { max-width: 1400px; display: grid; grid-template-columns: .82fr 1.18fr; align-items: center; gap: clamp(28px, 5vw, 78px); margin: 70px auto 90px; padding: 0 50px; }
.landing-film-copy .eyebrow { color: #0B737A; }
.landing-film-copy h2 { margin: 12px 0 15px; color: #14213d; font: 800 clamp(30px, 4vw, 48px)/1.12 Manrope, sans-serif; letter-spacing: -1.6px; }
.landing-film-copy h2 em { color: #0B737A; font-style: normal; }
.landing-film-copy p { max-width: 390px; color: #64748b; font-size: 14px; line-height: 1.8; }
.landing-film-frame { position: relative; min-height: 310px; overflow: hidden; border: 1px solid rgba(20,33,61,.12); border-radius: 18px; background: #101d31; box-shadow: 0 20px 50px rgba(20,33,61,.16); }
.landing-film-frame::after { content: ''; position: absolute; inset: 45% 0 0; pointer-events: none; background: linear-gradient(180deg,transparent,rgba(7,18,34,.6)); }
.landing-film-frame video { width: 100%; height: 100%; min-height: 310px; position: absolute; inset: 0; display: block; object-fit: cover; }
.landing-film-caption { position: absolute; z-index: 2; bottom: 17px; left: 19px; color: rgba(255,255,255,.8); font-size: 8px; font-weight: 750; letter-spacing: 1.3px; }

/* Split-screen authentication: image-led navy panel and clear ivory form panel. */
.auth-backdrop { z-index: 120; }
.auth-backdrop .auth-split-card { width: min(1060px, 100%); max-height: min(860px, 94vh); min-height: 630px; grid-template-columns: .92fr 1.08fr; border: 1px solid rgba(20,33,61,.13); border-radius: 18px; background: #fbfaf7; box-shadow: 0 30px 100px rgba(0,0,0,.4); }
.auth-backdrop .auth-split-left { position: relative; isolation: isolate; padding: 36px 34px; border: 0; background: linear-gradient(180deg,rgba(8,20,38,.7),rgba(8,20,38,.9)),url('/images/freightpilot-auth-ship.png') center/cover no-repeat; }
.auth-backdrop .auth-split-left::before { z-index: -1; top: auto; bottom: -150px; left: -110px; width: 360px; height: 360px; background: radial-gradient(circle,rgba(11, 115, 122,.22),transparent 68%); }
.auth-backdrop .auth-brand-info span { color: rgba(255,255,255,.74); }
.auth-backdrop .auth-split-benefits { margin: auto 0; gap: 22px; }
.auth-backdrop .benefit-icon { color: #ff897c; border-color: rgba(255,255,255,.16); background: rgba(255,255,255,.09); }
.auth-backdrop .benefit-text strong { color: #fff; font-size: 13px; }
.auth-backdrop .benefit-text p { color: rgba(255,255,255,.68); }
.auth-backdrop .auth-split-foot { color: rgba(255,255,255,.58); }
.auth-backdrop .auth-split-right { padding: 40px clamp(25px,4vw,48px); color: #14213d; background: #fbfaf7; }
.auth-backdrop .auth-toggle-pill { margin-bottom: 26px; padding: 4px; border-color: #e7e2d8; background: #f0eee8; }
.auth-backdrop .auth-toggle-pill button { color: #697487; }
.auth-backdrop .auth-toggle-pill button.active { color: #fff; background: #14213d; box-shadow: none; }
.auth-backdrop .auth-right-head h3 { color: #14213d; font-size: 28px; letter-spacing: -.8px; }
.auth-backdrop .auth-right-head p { color: #6b7482; }
.auth-backdrop .auth-close-btn { color: #667085; background: #f0eee8; }
.auth-backdrop .auth-social-stack { gap: 9px; }
.auth-backdrop .btn-social { min-height: 44px; border-color: #e0e3e5; color: #27354d; background: #fff; }
.auth-backdrop .btn-social:hover:not(:disabled) { border-color: #bfc8d0; background: #f7f8f8; }
.auth-backdrop .btn-social:disabled { opacity: .55; cursor: not-allowed; }
.auth-backdrop .auth-or-divider { color: #9299a1; }
.auth-backdrop .auth-or-divider::before, .auth-backdrop .auth-or-divider::after { background: #e3e5e5; }
.auth-backdrop .auth-input-group { margin-bottom: 12px; }
.auth-backdrop .auth-input-field, .auth-backdrop .auth-fields label input { min-height: 45px; border: 1px solid #dfe3e5; border-radius: 8px; color: #14213d; background: #fff; }
.auth-backdrop .auth-input-field::placeholder, .auth-backdrop .auth-fields label input::placeholder { color: #9ba3ac; }
.auth-backdrop .auth-input-field:focus, .auth-backdrop .auth-fields label input:focus { border-color: #0B737A; box-shadow: 0 0 0 3px rgba(11, 115, 122,.12); }
.auth-backdrop .input-icon-slot { color: #87909c; }
.auth-backdrop .auth-fields label { display: block; margin: 10px 0; color: #465267; font-size: 11px; font-weight: 650; }
.auth-backdrop .auth-fields label input { width: 100%; padding: 0 13px; margin-top: 6px; outline: 0; }
.auth-backdrop .auth-role-selector { display: flex; gap: 8px; margin: 0 0 14px; }
.auth-backdrop .auth-role-selector .btn { min-height: 35px; flex: 1; }
.auth-backdrop .btn-auth-submit { min-height: 46px; margin-top: 3px; border-radius: 8px; color: #fff; background: #0B737A; box-shadow: 0 8px 20px rgba(11, 115, 122,.2); }
.auth-backdrop .btn-auth-submit:hover:not(:disabled) { background: #f15e50; }
.auth-backdrop .auth-forgot-link { color: #075E68; }
.auth-backdrop .auth-security-note { color: #9299a1; }
.auth-backdrop .auth-provider-note { color: #7a8490; }
.auth-backdrop .inline-alert-danger { color: #a23a32; background: #fff0ee; border-color: #ffd5cf; }

@media (max-width: 780px) {
  .landing-film-section { grid-template-columns: 1fr; margin: 48px auto 60px; padding: 0 22px; }
  .landing-film-frame, .landing-film-frame video { min-height: 230px; }
  .auth-backdrop .auth-split-card { width: min(540px, 100%); min-height: auto; max-height: 94vh; grid-template-columns: 1fr; overflow-y: auto; }
  .auth-backdrop .auth-split-left { min-height: 230px; padding: 25px; }
  .auth-backdrop .auth-split-benefits { display: none; }
  .auth-backdrop .auth-split-foot { margin-top: 42px; }
  .auth-backdrop .auth-split-right { padding: 28px 24px; }
}


