/* Primary landing hero media: real supplied yacht footage with visible moving sea. */
.landing-hero-scene-wrap { position:relative !important; z-index:4; width:100%; min-width:0; height:clamp(330px,39vw,510px); min-height:0 !important; align-self:center; display:flex; align-items:center; justify-content:center; margin:0 0 18px; overflow:hidden; animation:fp-fade-up 1s .12s both; }
.landing-hero-video-frame { position:relative; isolation:isolate; width:min(100%,700px); height:100%; overflow:hidden; border-radius:4px 22px 22px 4px; background:#071a2a; box-shadow:0 28px 80px rgba(0,0,0,.34); }
.landing-hero-video { position:absolute; inset:0; display:block; width:100%; height:100%; object-fit:cover; object-position:center; transform:scale(1.025); }
.landing-hero-video-shade { position:absolute; z-index:1; inset:0; pointer-events:none; background:linear-gradient(90deg,rgba(8,20,38,.24),transparent 30%),linear-gradient(180deg,rgba(5,15,28,.02) 48%,rgba(5,15,28,.35)); }
.landing-hero-video-frame::before { content:""; position:absolute; z-index:2; inset:0; pointer-events:none; border:1px solid rgba(236,244,249,.2); border-radius:inherit; }
.landing-hero-video-caption { position:absolute; z-index:3; right:18px; bottom:17px; display:flex; align-items:center; gap:9px; padding:9px 12px; border:1px solid rgba(255,255,255,.18); border-radius:999px; color:rgba(255,255,255,.88); background:rgba(5,17,31,.48); backdrop-filter:blur(12px); font-size:8px; font-weight:800; letter-spacing:1.4px; }
.landing-hero-video-caption .hero-live-dot { margin:0; }
@media (max-width:1050px) and (min-width:761px) { .landing-hero-scene-wrap { height:clamp(280px,36vw,410px); } }
@media (max-width:760px) { .landing-hero-main { display:flex; flex-direction:column; align-items:stretch; } .landing-hero-scene-wrap { order:2; height:clamp(220px,62vw,340px); min-height:0 !important; margin:12px 0 24px; } .landing-hero-video-frame { width:100%; border-radius:14px; } }
@media (prefers-reduced-motion:reduce) { .landing-hero-video { display:none; } .landing-hero-video-frame { background:#071a2a url('/images/yacht-poster.png') center/cover no-repeat; } }

/* --------------------------------------------------------------------------
   NOV 10 UI RESTORATION — light workspace, full-bleed yacht landing hero,
   and split-screen authentication using the supplied cargo-ship photograph.
   -------------------------------------------------------------------------- */
:root {
  color-scheme: light;
  --page-bg: #f4f7f7;
  --page-surface: #ffffff;
  --page-ink: #172a30;
  --page-muted: #65757b;
  --page-border: #dfe7e8;
  --page-teal: #075e68;
  --page-teal-hover: #064d56;
}
html, body, #root { min-height: 100%; }
html, html.dark { color-scheme: light !important; background: var(--page-bg) !important; }
body { background: var(--page-bg) !important; color: var(--page-ink); }

/* Landing: yacht film is the complete hero background, with readable overlay. */
.public-website-shell,
.landing-page { background: #f4f7f7 !important; color: var(--page-ink); }
.landing-hero {
  position: relative !important;
  isolation: isolate;
  min-height: min(940px, 100svh) !important;
  height: min(940px, 100svh);
  padding: 22px clamp(22px, 4.6vw, 72px) 18px !important;
  overflow: hidden;
  background: #0b2536 !important;
  color: #fff !important;
}
.landing-hero-scene-wrap {
  position: absolute !important; z-index: 0 !important; inset: 0 !important;
  width: 100% !important; height: 100% !important; min-height: 0 !important;
  margin: 0 !important; display: block !important; animation: none !important;
}
.landing-hero-video-frame {
  position: absolute !important; inset: 0 !important; width: 100% !important;
  height: 100% !important; max-width: none !important; border-radius: 0 !important;
  box-shadow: none !important; background: #08283a !important;
}
.landing-hero-video {
  object-fit: cover !important; object-position: center 52% !important;
  transform: none !important; filter: saturate(1.04) contrast(1.02);
}
.landing-hero-video-shade {
  background: linear-gradient(90deg, rgba(4,22,37,.76) 0%, rgba(4,22,37,.52) 43%, rgba(4,22,37,.12) 100%),
    linear-gradient(180deg, rgba(4,22,37,.28) 0%, transparent 34%, rgba(4,22,37,.45) 100%) !important;
}
.landing-hero-video-frame::before { border: 0 !important; border-radius: 0 !important; }
.landing-hero-video-caption { right: clamp(20px,4vw,56px) !important; bottom: 82px !important; }
.landing-nav, .landing-hero-main, .landing-hero-footer { position: relative !important; z-index: 3 !important; }
.landing-nav { max-width: 1440px; }
.landing-hero-main {
  display: flex !important; align-items: center !important; width: 100% !important;
  max-width: 1440px !important; min-height: 0 !important; flex: 1 1 auto;
  margin: 0 auto !important; padding: 34px 0 52px;
}
.landing-content { width: min(720px,62vw) !important; max-width: 720px !important; margin: 0 !important; padding: 48px 0 42px !important; }
.landing-badge { background: rgba(8,35,51,.52) !important; color: #d0f0ef !important; border-color: rgba(211,245,244,.42) !important; }
.landing-title { color: #fff !important; text-shadow: 0 2px 24px rgba(0,0,0,.18); }
.landing-title span { color: #76D4D0 !important; }
.landing-subtitle { color: rgba(255,255,255,.9) !important; }
.landing-proof-row { color: rgba(255,255,255,.88) !important; }
.landing-hero-footer { border-color: rgba(255,255,255,.25) !important; color: rgba(255,255,255,.76) !important; }
.landing-nav-links a, .landing-nav-links button { color: rgba(255,255,255,.92) !important; }
.landing-brand-copy strong { color: white !important; }
.landing-brand-copy small { color: rgba(255,255,255,.76) !important; }
.landing-nav-actions .fpw-theme-toggle, .fpw-theme-toggle { display: none !important; }

/* Public sections below the film hero use the requested light theme. */
.landing-capability-strip, .landing-capabilities, .landing-workflow, .landing-film-section {
  background: #f4f7f7 !important; color: var(--page-ink) !important;
}
.landing-section-heading h2, .workflow-copy h2 { color: #1c3036 !important; }
.landing-section-heading p, .workflow-copy p { color: #65757b !important; }
.feature-card, .stats-metric-card {
  color: var(--page-ink) !important; background: #fff !important;
  border-color: #e1e8e8 !important; box-shadow: 0 8px 28px rgba(17,48,58,.055) !important;
}
.feature-card h3, .stats-metric-card span { color: #1d3339 !important; }
.feature-card p { color: #69797e !important; }
.landing-footer { background: #edf3f3 !important; color: #52656b !important; }

/* Sign-in / sign-up: form on the left, supplied cargo ship photo on right. */
.auth-backdrop { padding: clamp(12px,3vw,38px) !important; background: #dce9ec !important; backdrop-filter: none !important; }
.auth-backdrop .auth-split-card {
  display: grid !important; grid-template-columns: minmax(0,1fr) minmax(0,1fr) !important;
