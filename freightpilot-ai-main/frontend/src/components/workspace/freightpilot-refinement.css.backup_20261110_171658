html.dark .workflow-copy p { color: rgba(244,237,224,.68); }
html.dark .feature-card,
html.dark .stats-metric-card { background: #19263d; border-color: rgba(244,237,224,.12); color: #f4ede0; }
html.dark .feature-card h3,
html.dark .stats-metric-card span { color: #f4ede0; }
